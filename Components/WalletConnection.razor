@using Crypto_Hockey.Models
@using Crypto_Hockey.Services
@inject IWalletService WalletService

<div class="wallet-card">
    <div class="wallet-header">
        <h3>Wallet Connection</h3>
    </div>

    @if (!WalletState.IsConnected)
    {
        <div class="wallet-disconnected">
            <p>Connect your MetaMask wallet to play and earn rewards!</p>
            <button class="btn btn-primary btn-lg" @onclick="ConnectWallet">
                <img src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 200 200' width='20' height='20'%3E%3Cpath fill='%23F6851B' d='M174 29l-24 6V8l24 21z'/%3E%3Cpath fill='%23763D16' d='M26 29L50 8v27L26 29z'/%3E%3Cpath fill='%23F6851B' d='M157 67l15-7-15 37v-30z'/%3E%3Cpath fill='%23763D16' d='M43 67L28 60l15 37v-30z'/%3E%3C/svg%3E" alt="MetaMask" /> 
                Connect MetaMask
            </button>
            @if (HasCheckedEnvironment && !MetaMaskInstalled)
            {
                <p class="warning-text">
                    MetaMask was not detected in this browser.
                    @if (IsMobileDevice)
                    {
                        <span> Open this link in the MetaMask app browser.</span>
                    }
                    else
                    {
                        <span> <a href="https://metamask.io" target="_blank">Install MetaMask</a> and reload.</span>
                    }
                </p>

                @if (IsMobileDevice)
                {
                    <button class="btn btn-outline-info mt-2" @onclick="OpenInMetaMaskApp">
                        Open in MetaMask App
                    </button>
                    @if (IsInAppBrowser)
                    {
                        <p class="warning-text mt-2">X/Twitter in-app browsers often block wallet injection. Opening this game in MetaMask should fix connection.</p>
                    }
                }
            }
        </div>
    }
    else
    {
        <div class="wallet-connected">
            <div class="wallet-info">
                <div class="info-row">
                    <span class="label">Address:</span>
                    <span class="address">@FormatAddress(WalletState.Address)</span>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="CopyAddress" title="Copy Address">📋</button>
                </div>
                <div class="info-row">
                    <span class="label">Network:</span>
                    <span class="network">@WalletState.ChainName</span>
                </div>
                <div class="info-row">
                    <span class="label">Balance:</span>
                    <span class="balance">@WalletState.Balance.ToString("F4") ETH</span>
                </div>
            </div>

            <div class="wallet-actions">
                <button class="btn btn-secondary" @onclick="SwitchNetwork">
                    Switch Network
                </button>
                <button class="btn btn-danger" @onclick="DisconnectWallet">
                    Disconnect
                </button>
            </div>
        </div>
    }
</div>

@code {
    private bool MetaMaskInstalled = false;
    private bool IsMobileDevice = false;
    private bool IsInAppBrowser = false;
    private bool HasCheckedEnvironment = false;
    private bool autoConnectPending = false;
    private bool autoConnectAttempted = false;

    [Parameter]
    public EventCallback<WalletConnectionState> OnWalletConnected { get; set; }

    [Parameter]
    public WalletConnectionState WalletState { get; set; } = new();

    [Parameter]
    public EventCallback<WalletConnectionState> WalletStateChanged { get; set; }

    [Parameter]
    public bool AutoConnect { get; set; }

    protected override void OnParametersSet()
    {
        if (AutoConnect && !WalletState.IsConnected && !autoConnectAttempted)
        {
            autoConnectPending = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var shouldRefreshUi = false;

        if (firstRender)
        {
            await RefreshWalletEnvironmentAsync();
            shouldRefreshUi = true;
        }

        if (autoConnectPending && !autoConnectAttempted)
        {
            autoConnectPending = false;
            autoConnectAttempted = true;
            await ConnectWalletInternalAsync(refreshEnvironment: true, allowDeepLinkFallback: false);
            shouldRefreshUi = true;
        }

        if (shouldRefreshUi)
        {
            StateHasChanged();
        }
    }

    private async Task ConnectWallet()
    {
        await ConnectWalletInternalAsync();
    }

    private async Task ConnectWalletInternalAsync(bool refreshEnvironment = true, bool allowDeepLinkFallback = true)
    {
        if (refreshEnvironment)
        {
            await RefreshWalletEnvironmentAsync();
        }

        if (allowDeepLinkFallback && IsMobileDevice && (!MetaMaskInstalled || IsInAppBrowser))
        {
            await OpenInMetaMaskApp();
            return;
        }

        WalletState = await WalletService.ConnectWalletAsync();
        await PublishWalletStateAsync();
        StateHasChanged();
    }

    private async Task OpenInMetaMaskApp()
    {
        await JSRuntime.InvokeAsync<bool>("window.metamaskInterop.openInMetaMask");
    }

    private async Task RefreshWalletEnvironmentAsync()
    {
        try
        {
            MetaMaskInstalled = await JSRuntime.InvokeAsync<bool>("window.metamaskInterop.isMetaMaskInstalled");
            IsMobileDevice = await JSRuntime.InvokeAsync<bool>("window.metamaskInterop.isMobileDevice");
            IsInAppBrowser = await JSRuntime.InvokeAsync<bool>("window.metamaskInterop.isInAppBrowser");
            WalletState = await WalletService.GetWalletStateAsync();
        }
        catch
        {
            MetaMaskInstalled = false;
            IsMobileDevice = false;
            IsInAppBrowser = false;
        }

        HasCheckedEnvironment = true;
    }

    private async Task DisconnectWallet()
    {
        await WalletService.DisconnectWalletAsync();
        WalletState = new WalletConnectionState { IsConnected = false };
        await PublishWalletStateAsync();
        StateHasChanged();
    }

    private async Task SwitchNetwork()
    {
        // Example: Switch to Sepolia testnet
        bool success = await WalletService.SwitchNetworkAsync(11155111);
        if (success)
        {
            WalletState = await WalletService.GetWalletStateAsync();
            await PublishWalletStateAsync();
            StateHasChanged();
        }
    }

    private async Task CopyAddress()
    {
        if (!string.IsNullOrEmpty(WalletState.Address))
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", WalletState.Address);
        }
    }

    private string FormatAddress(string? address)
    {
        if (string.IsNullOrEmpty(address) || address.Length < 10)
            return address ?? "";
        return $"{address[..6]}...{address[^4..]}";
    }

    private async Task PublishWalletStateAsync()
    {
        await WalletStateChanged.InvokeAsync(WalletState);
        await OnWalletConnected.InvokeAsync(WalletState);
    }

    @inject IJSRuntime JSRuntime
}
