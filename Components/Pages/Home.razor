@page "/"

<PageTitle>Crypto Hockey</PageTitle>

<div class="hero-section">
    <div class="hero-content">
        <h1 class="display-4">🏒 Crypto Hockey</h1>
        <p class="lead">The classic game of air hockey, powered by blockchain rewards!</p>

        <div class="feature-highlights">
            <div class="feature-card">
                <h3>⚡ Play & Earn</h3>
                <p>Win games and earn A1870 tokens directly to your wallet</p>
            </div>
            <div class="feature-card">
                <h3>🎮 Fun & Fast</h3>
                <p>Enjoy fast-paced air hockey action against an intelligent AI opponent</p>
            </div>
            <div class="feature-card">
                <h3>🔐 Secure</h3>
                <p>Connect with MetaMask for a secure, decentralized gaming experience</p>
            </div>
        </div>

        <div class="cta-buttons">
            <a href="/game" class="btn btn-primary btn-lg">
                Start Playing Now
            </a>
            <a href="/leaderboard" class="btn btn-outline-primary btn-lg">
                View Leaderboard
            </a>
        </div>
    </div>
</div>

<div class="info-section">
    <div class="container">
        <h2>How It Works</h2>
        <div class="row mt-4">
            <div class="col-md-4">
                <div class="step-card">
                    <div class="step-number">1</div>
                    <h4>Connect Wallet</h4>
                    <p>Connect your MetaMask wallet to get started</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="step-card">
                    <div class="step-number">2</div>
                    <h4>Choose Difficulty</h4>
                    <p>Select Easy, Medium, or Hard AI opponent</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="step-card">
                    <div class="step-number">3</div>
                    <h4>Win & Claim</h4>
                    <p>Beat the AI and claim your A1870 reward tokens</p>
                </div>
            </div>
        </div>
    </div>
</div>

