@page "/"
@rendermode InteractiveServer
@inject IJSRuntime JSRuntime
@inject Microsoft.Extensions.Options.IOptions<Crypto_Hockey.Models.BlockchainConfig> BlockchainOptions

<PageTitle>Crypto Hockey</PageTitle>

<div class="hero-section">
    <div class="hero-content">
        <h1 class="display-4">🏒 Crypto Hockey</h1>
        <p class="lead">The classic game of air hockey, powered by blockchain rewards!</p>

        <div class="homepage-wallet-entry">
            <button class="btn btn-primary btn-lg wallet-launch-btn"
                    @onclick="OpenGameWithMetaMask"
                    aria-describedby="homepage-wallet-launch-help"
                    aria-label="Connect MetaMask and open Crypto Hockey. On mobile this opens the game in the MetaMask app browser.">
                Connect MetaMask &amp; Play
            </button>
            <p class="wallet-launch-help" id="homepage-wallet-launch-help">Open the game, connect MetaMask, and start playing right away.</p>
        </div>

        <div class="feature-highlights">
            <div class="feature-card">
                <h3>⚡ Play & Earn</h3>
                <p>Win games and earn A1870 tokens directly to your wallet</p>
            </div>
            <div class="feature-card">
                <h3>🎮 Fun & Fast</h3>
                <p>Enjoy fast-paced air hockey action against an intelligent AI opponent</p>
            </div>
            <div class="feature-card">
                <h3>♠️ Online Arena</h3>
                <p>Compete at heads-up tables and 8-player tournaments inspired by GG Poker lobbies</p>
            </div>
            <div class="feature-card">
                <h3>🔐 Secure</h3>
                <p>Shared Arcade1870 reward vault + issuer payout flow aligned with Crypto Chess</p>
            </div>
        </div>
    </div>
</div>

<div class="info-section">
    <div class="container">
        <h2>How It Works</h2>
        <div class="row mt-4">
            <div class="col-md-4">
                <div class="step-card">
                    <div class="step-number">1</div>
                    <h4>Connect Wallet</h4>
                    <p>Connect your MetaMask wallet to get started</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="step-card">
                    <div class="step-number">2</div>
                    <h4>Open the Game</h4>
                    <p>Use the Connect MetaMask &amp; Play button on this page to open the game and connect your wallet</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="step-card">
                    <div class="step-number">3</div>
                    <h4>Win & Claim</h4>
                    <p>Beat the AI and claim your A1870 reward tokens</p>
                </div>
            </div>

        </div>
    </div>
</div>

<div class="container mt-4">
    <div class="card import-token-card">
        <div class="card-body">
            <h2 class="h4">🦊 See Your Rewards: Import the Arcade1870 Token into MetaMask</h2>
            <p>
                Reward payouts are sent to your wallet automatically, but MetaMask does not show new tokens until you import them.
                If your A1870 balance is not visible after claiming a reward, import the token once using the details below.
            </p>

            <ul class="list-unstyled mb-3">
                <li><strong>Token Name:</strong> Arcade1870</li>
                <li><strong>Token Symbol:</strong> A1870</li>
                <li><strong>Token Decimals:</strong> @TokenDecimals</li>
                <li><strong>Network:</strong> Ethereum Mainnet</li>
                <li>
                    <strong>Token Contract Address:</strong>
                    <code class="text-break" id="arcade1870-contract-address">@TokenContractAddress</code>
                </li>
            </ul>

            <h3 class="h5">How to import the token</h3>
            <ol>
                <li>Open MetaMask and make sure <strong>Ethereum Mainnet</strong> is selected as the network.</li>
                <li>On the <strong>Tokens</strong> tab, scroll down and tap <strong>Import tokens</strong>.</li>
                <li>Choose the <strong>Custom token</strong> option.</li>
                <li>Paste the Token Contract Address shown above: <code class="text-break">@TokenContractAddress</code></li>
                <li>MetaMask should fill in the symbol <strong>A1870</strong> and decimals <strong>@TokenDecimals</strong> automatically. If not, enter them manually.</li>
                <li>Tap <strong>Next</strong>, then <strong>Import</strong>. Your Arcade1870 (A1870) balance will now appear in your wallet.</li>
            </ol>
            <p class="mb-0 text-muted small">You only need to do this once per wallet. Always verify the contract address matches exactly before importing.</p>
        </div>
    </div>
</div>

<div class="container mt-4 mb-5">
    <div class="alert alert-secondary text-center">
        For customer support, email <a href="mailto:Support1870@gmail.com">Support1870@gmail.com</a>.
    </div>
</div>

@code {
    private const string DefaultTokenContractAddress = "0x8eddD4edea39c5B5f77662453600F53A202EE47C";

    private string TokenContractAddress =>
        string.IsNullOrWhiteSpace(BlockchainOptions.Value.Arcade1870ContractAddress)
            ? DefaultTokenContractAddress
            : BlockchainOptions.Value.Arcade1870ContractAddress.Trim();

    private int TokenDecimals => BlockchainOptions.Value.RewardTokenDecimals;

    private async Task OpenGameWithMetaMask()
    {
        await JSRuntime.InvokeVoidAsync("window.metamaskInterop.openGameInMetaMask");
    }
}
