@using Crypto_Hockey.Services
@using Crypto_Hockey.Models
@using Microsoft.AspNetCore.WebUtilities
@page "/game"
@page "/game/autoconnect"
@rendermode InteractiveServer
@implements IAsyncDisposable

<PageTitle>Crypto Hockey - Play</PageTitle>

<div class="game-container">
    <div class="game-sidebar">
        <WalletConnection @ref="walletComponent" @bind-WalletState="currentWalletState" />

        <div class="game-stats">
            <h4>Game Stats</h4>
            @if (currentWalletState.IsConnected)
            {
                <div class="stats-info">
                    <p>Player: @playerProfile?.WalletAddress?.Substring(0, 6)...</p>
                    <p>Total Wins: @playerProfile?.TotalWins</p>
                    <p>Total Games: @playerProfile?.TotalGames</p>
                    <p>Win Rate: @((playerProfile?.WinRate ?? 0).ToString("F1"))%</p>
                    <p>Total Rewards: @playerProfile?.TotalRewardsEarned.ToString("F2") A1870</p>
                </div>
            }
            else
            {
                <p class="text-muted">Connect wallet to see your stats</p>
            }
        </div>

        <div class="game-controls">
            <h4>Game Settings</h4>
            @if (!string.IsNullOrWhiteSpace(gameErrorMessage))
            {
                <div class="alert alert-danger" role="alert">
                    @gameErrorMessage
                    @if (!string.IsNullOrWhiteSpace(rewardDiagnosticHint))
                    {
                        <div class="mt-2 small">
                            <strong>Debug hint:</strong> @rewardDiagnosticHint
                        </div>
                    }
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(rewardWarningMessage))
            {
                <div class="alert alert-warning" role="alert">
                    @rewardWarningMessage
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(rewardStatusMessage))
            {
               <div class="alert @(rewardClaimed ? "alert-success" : "alert-info")" role="status" aria-live="polite">
                   @rewardStatusMessage
                   @if (rewardClaimed && !string.IsNullOrWhiteSpace(rewardTransactionHash))
                   {
                       <div class="mt-2 small">
                           Transaction:
                           @if (!string.IsNullOrWhiteSpace(rewardExplorerUrl))
                           {
                               <a href="@rewardExplorerUrl" target="_blank" rel="noopener noreferrer">@rewardTransactionHash</a>
                           }
                           else
                           {
                               <code>@rewardTransactionHash</code>
                           }
                       </div>
                   }
               </div>
            }
            <div class="form-group">
               <label for="difficulty">Difficulty:</label>
               <select id="difficulty" class="form-control" @bind="selectedDifficulty">
                   <option value="Easy">Easy</option>
                   <option value="Medium" selected>Medium</option>
                    <option value="Hard">Hard</option>
                </select>
            </div>

            @if (!gameRunning && !gameOver)
            {
                <button class="btn btn-success btn-block" @onclick="StartGame" disabled="@(!currentWalletState.IsConnected)">
                    @(gamePaused ? "Resume Game" : "Start Game")
                </button>
            }
            else if (gameRunning)
            {
                <button class="btn btn-warning btn-block" @onclick="PauseGame">
                    Pause Game
                </button>
            }

            @if (gameOver)
            {
                <button class="btn btn-primary btn-block" @onclick="ResetGame">
                    Play Again
                </button>
               @if (!rewardClaimed && !rewardClaimInProgress)
                {
                   <button class="btn btn-info btn-block mt-2" @onclick="RetryRewardClaim">
                       Retry Reward Payout
                    </button>
                }
            }
        </div>
    </div>

    <div class="game-area">
        <div class="game-header">
            <div class="score-board">
                <div class="player-score">
                    <span class="label">You</span>
                    <span class="score">@playerScore</span>
                </div>
                <div class="divider">-</div>
                <div class="opponent-score">
                    <span class="score">@opponentScore</span>
                    <span class="label">AI</span>
                </div>
            </div>
        </div>

        <canvas @ref="canvasRef" 
                width="800" 
                height="400" 
                class="game-canvas">
        </canvas>

    </div>
</div>

@code {
    private ElementReference canvasRef;
    private WalletConnection? walletComponent;
    private WalletConnectionState currentWalletState = new();
    private PlayerProfile? playerProfile;

    private bool gameRunning = false;
    private bool gamePaused = false;
    private bool gameOver = false;
    private bool playerWon = false;
    private bool rewardClaimed = false;
    private bool rewardClaimInProgress = false;
    private int playerScore = 0;
    private int opponentScore = 0;
    private string selectedDifficulty = "Medium";
    private int? currentSessionId;
    private string? gameErrorMessage;
    private string? rewardWarningMessage;
    private string? rewardStatusMessage;
    private string? rewardDiagnosticHint;
    private string? rewardTransactionHash;
    private string? rewardExplorerUrl;

    private DotNetObjectReference<Game>? gameCallbacksRef;
    private int activeGameToken;
    private bool gameCompletionInProgress;
    [Inject] IGameService GameService { get; set; } = null!;
    [Inject] IWalletService WalletService { get; set; } = null!;
    [Inject] IJSRuntime JSRuntime { get; set; } = null!;
    [Inject] NavigationManager NavigationManager { get; set; } = null!;
    [Inject] ILogger<Game> Logger { get; set; } = null!;

    private bool AutoConnectWallet
    {
        get
        {
            var currentUri = new Uri(NavigationManager.Uri);

            if (string.Equals(currentUri.AbsolutePath, "/game/autoconnect", StringComparison.OrdinalIgnoreCase))
            {
                return true;
            }

            var query = QueryHelpers.ParseQuery(currentUri.Query);
            if (!query.TryGetValue("autoconnect", out var values))
            {
                return false;
            }

            var value = values.Count > 0 ? values[0] : null;
            return string.IsNullOrWhiteSpace(value)
                || string.Equals(value, "true", StringComparison.OrdinalIgnoreCase)
                || string.Equals(value, "1", StringComparison.OrdinalIgnoreCase);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            gameCallbacksRef = DotNetObjectReference.Create(this);

            if (AutoConnectWallet && walletComponent is not null && !currentWalletState.IsConnected)
            {
                await walletComponent.ConnectForLaunchAsync();
            }
        }
    }

    private async Task StartGame()
    {
        if (!currentWalletState.IsConnected || string.IsNullOrEmpty(currentWalletState.Address))
        {
            return;
        }

        if (gameRunning)
        {
            return;
        }

        if (gamePaused && currentSessionId.HasValue)
        {
            gameRunning = true;
            gamePaused = false;
            await JSRuntime.InvokeVoidAsync("window.gameRenderer.resumeGame", canvasRef);
            StateHasChanged();
            return;
        }

        try
        {
            gameErrorMessage = null;
            rewardWarningMessage = null;
            rewardDiagnosticHint = null;

            // Get or create player profile
            playerProfile = await GameService.GetOrCreatePlayerAsync(currentWalletState.Address);

            // Create game session
            var session = await GameService.CreateGameSessionAsync(currentWalletState.Address, selectedDifficulty);
            currentSessionId = session.Id;

            activeGameToken++;
            gameRunning = true;
            gamePaused = false;
            gameOver = false;
            playerWon = false;
            rewardClaimed = false;
            rewardClaimInProgress = false;
            playerScore = 0;
            opponentScore = 0;
            rewardStatusMessage = null;
            rewardWarningMessage = null;
            rewardTransactionHash = null;
            rewardExplorerUrl = null;
            await JSRuntime.InvokeVoidAsync(
                "window.gameRenderer.startGame",
                canvasRef,
                selectedDifficulty,
                gameCallbacksRef,
                activeGameToken);
        }
        catch (Exception ex)
        {
            gameRunning = false;
            currentSessionId = null;
            gameErrorMessage = "Unable to start the game right now. Please try again in a moment.";
            Logger.LogError(ex, "Error starting game for wallet {WalletAddress}", currentWalletState.Address);
        }

        StateHasChanged();
    }

    private async Task PauseGame()
    {
        gameRunning = false;
        gamePaused = true;
        await JSRuntime.InvokeVoidAsync("window.gameRenderer.pauseGame", canvasRef);
        StateHasChanged();
    }

    private async Task ResetGame()
    {
        await JSRuntime.InvokeVoidAsync("window.gameRenderer.resetGame", canvasRef);
        gameOver = false;
        gamePaused = false;
        gameRunning = false;
        playerWon = false;
        rewardClaimed = false;
        rewardClaimInProgress = false;
        playerScore = 0;
        opponentScore = 0;
        currentSessionId = null;
        gameErrorMessage = null;
        rewardWarningMessage = null;
        rewardStatusMessage = null;
        rewardDiagnosticHint = null;
        rewardTransactionHash = null;
        rewardExplorerUrl = null;
        activeGameToken++;
        StateHasChanged();
    }

    [JSInvokable]
    public Task OnGameScoreChanged(int latestPlayerScore, int latestOpponentScore, int gameToken)
    {
        if (gameToken != activeGameToken)
        {
            return Task.CompletedTask;
        }

        playerScore = latestPlayerScore;
        opponentScore = latestOpponentScore;
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task OnGameCompleted(int finalPlayerScore, int finalOpponentScore, int gameToken)
    {
        if (gameToken != activeGameToken || !gameRunning)
        {
            return;
        }

        if (gameCompletionInProgress)
        {
            return;
        }

        gameRunning = false;
        gamePaused = false;
        gameOver = true;
        playerScore = finalPlayerScore;
        opponentScore = finalOpponentScore;
        playerWon = playerScore > opponentScore;
        gameCompletionInProgress = true;

        try
        {
            if (currentSessionId.HasValue)
            {
                var completedSessionId = currentSessionId.Value;
                await GameService.EndGameSessionAsync(completedSessionId, playerScore, opponentScore);
                await ClaimRewardAsync();
                currentSessionId = null;
            }
        }
        catch (Exception ex)
        {
            gameErrorMessage = "We couldn't finalize this game session. Please try another match in a moment.";
            Logger.LogError(ex, "Error finalizing game completion for session {SessionId}", currentSessionId);
        }
        finally
        {
            gameCompletionInProgress = false;
        }

        await InvokeAsync(StateHasChanged);
    }

    private Task RetryRewardClaim()
    {
        return ClaimRewardAsync();
    }

    private async Task ClaimRewardAsync()
    {
        if (!currentSessionId.HasValue || rewardClaimed || rewardClaimInProgress)
        {
            return;
        }

        try
        {
            rewardClaimInProgress = true;
            gameErrorMessage = null;
            rewardWarningMessage = null;
            rewardDiagnosticHint = null;
            rewardStatusMessage = "Preparing your reward claim...";
            rewardTransactionHash = null;
            rewardExplorerUrl = null;
            await InvokeAsync(StateHasChanged);

            var preparedClaim = await GameService.PrepareRewardClaimAsync(currentSessionId.Value, currentWalletState.Address!);
            if (!preparedClaim.IsSuccessful || preparedClaim.Transaction is null)
            {
                rewardStatusMessage = null;
                gameErrorMessage = preparedClaim.ErrorMessage ?? "Reward payout could not be prepared right now. You can retry below.";
                rewardWarningMessage = null;
                rewardDiagnosticHint = preparedClaim.DiagnosticHint;
                return;
            }

            rewardStatusMessage = "Confirm the reward claim in MetaMask to receive your tokens.";
            await InvokeAsync(StateHasChanged);

            var walletResult = await WalletService.SubmitRewardClaimAsync(preparedClaim.Transaction);
            if (walletResult.IsSuccessful && !string.IsNullOrWhiteSpace(walletResult.TransactionHash))
            {
                var completed = await GameService.CompleteRewardClaimAsync(
                    currentSessionId.Value,
                    currentWalletState.Address!,
                    walletResult.TransactionHash);

                if (completed)
                {
                    rewardClaimed = true;
                    rewardStatusMessage = "Reward claim submitted.";
                    rewardWarningMessage = null;
                    rewardDiagnosticHint = null;
                    rewardTransactionHash = walletResult.TransactionHash;
                    rewardExplorerUrl = BuildExplorerTransactionUrl(
                        preparedClaim.Transaction.ChainId,
                        walletResult.TransactionHash);

                    if (currentWalletState.IsConnected)
                    {
                        playerProfile = await GameService.GetOrCreatePlayerAsync(currentWalletState.Address!);
                    }
                }
                else
                {
                    rewardStatusMessage = null;
                    gameErrorMessage = "Reward transaction was submitted, but the game could not record it. Please contact support with the transaction hash.";
                    rewardWarningMessage = null;
                    rewardDiagnosticHint = null;
                    Logger.LogError(
                        "Reward claim transaction {TransactionHash} submitted for session {SessionId} but completion could not be recorded.",
                        walletResult.TransactionHash,
                        currentSessionId);
                }
            }
            else
            {
                rewardStatusMessage = null;
                var walletError = string.IsNullOrWhiteSpace(walletResult.ErrorMessage)
                    ? "Reward payout could not be completed right now. You can retry below."
                    : walletResult.ErrorMessage;
                if (string.Equals(walletResult.ErrorCode, "LOW_GAS", StringComparison.Ordinal))
                {
                    rewardWarningMessage = walletError;
                    gameErrorMessage = null;
                }
                else
                {
                    rewardWarningMessage = null;
                    gameErrorMessage = walletError;
                }
                rewardDiagnosticHint = null;
                rewardTransactionHash = null;
                rewardExplorerUrl = null;
            }
        }
        catch (Exception ex)
        {
            rewardStatusMessage = null;
            gameErrorMessage = "Reward payout failed. Please try again shortly.";
            rewardWarningMessage = null;
            rewardDiagnosticHint = null;
            rewardTransactionHash = null;
            rewardExplorerUrl = null;
            Logger.LogError(ex, "Error claiming reward for session {SessionId}", currentSessionId);
        }
        finally
        {
            rewardClaimInProgress = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private static string? BuildExplorerTransactionUrl(int chainId, string transactionHash)
    {
        if (string.IsNullOrWhiteSpace(transactionHash))
        {
            return null;
        }

        var baseUrl = chainId switch
        {
            1 => "https://etherscan.io/tx/",
            11155111 => "https://sepolia.etherscan.io/tx/",
            137 => "https://polygonscan.com/tx/",
            _ => null
        };

        return baseUrl is null ? null : $"{baseUrl}{transactionHash}";
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("window.gameRenderer.disposeGame", canvasRef);
        }
        catch
        {
            // best effort cleanup
        }

        gameCallbacksRef?.Dispose();
    }
}
